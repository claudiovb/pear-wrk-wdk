{
  "name": "@tetherto/pear-wrk-wdk",
  "description": "Bare worklet infrastructure for WDK (Wallet Development Kit) by Tether.",
  "homepage": "https://docs.wdk.tether.io/tools/pear-wrk-wdk/",
  "keywords": [
    "wdk"
  ],
  "version": "1.0.0-beta.18",
  "main": "index.js",
  "scripts": {
    "build:types": "tsc --noEmit",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "node --test test/**/*.test.js",
    "test:watch": "node --test --watch test/**/*.test.js",
    "test:stow": "node --test test/stow.smoke.js",
    "gen:rpcs": "node scripts/generate-rpcs.js",
    "prepare": "npm run gen:rpcs"
  },
  "files": [
    "index.js",
    "worklet.js",
    "jsonrpc.js",
    "src",
    "types",
    "generated",
    "package.json",
    "README.md"
  ],
  "dependencies": {
    "@scure/bip39": "^2.2.0",
    "bare-abort-controller": "^1.1.2",
    "bare-rpc": "^2.0.0",
    "compact-encoding": "^3.3.0",
    "hrpc": "^4.3.2",
    "hyperschema": "^1.12.4"
  },
  "peerDependencies": {
    "bare-crypto": ">=1.13.1"
  },
  "optionalDependencies": {
    "bare-walk-handles": "^2.1.0"
  },
  "devDependencies": {
    "bare-ipc": "^1.1.1",
    "bare-sidecar": "^0.5.16",
    "bare-stow": "^0.3.9",
    "bare-stow-host": "^0.2.0",
    "bare-stow-runtime": "^0.1.2",
    "bare-wdk-runtime": "^3.0.1",
    "rimraf": "6.0.1",
    "standard": "17.1.2",
    "typescript": "5.8.3"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    },
    "./worklet": {
      "types": "./types/worklet.d.ts",
      "default": "./worklet.js"
    },
    "./diagnostics/handle-leak-check": {
      "types": "./types/diagnostics/handle-leak-check.d.ts",
      "default": "./src/diagnostics/handle-leak-check.js"
    },
    "./jsonrpc": {
      "types": "./types/jsonrpc.d.ts",
      "default": "./jsonrpc.js"
    },
    "./package.json": "./package.json",
    "./hrpc": {
      "types": "./types/hrpc/hrpc.d.ts",
      "default": "./generated/hrpc/index.js"
    },
    "./bare-rpc": {
      "types": "./types/bare-rpc.d.ts",
      "default": "./generated/bare-rpc/index.js"
    }
  },
  "author": "Tether",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git://github.com/tetherto/pear-wrk-wdk.git"
  }
}
